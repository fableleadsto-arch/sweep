[TEMPLATE]
# -----------------------------------------------------------------------------
#  RelayAI - complete environment reference
#  Copy to .env and fill in what you use. The app boots with the
#  minimum set (SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY); every
#  other variable is optional and degrades gracefully when unset.
# -----------------------------------------------------------------------------

# ---- Required --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- Server-only (never expose to the client) ------------------------------
# Admin server functions require this; the site still boots without it.
SUPABASE_SERVICE_ROLE_KEY=
# Used by the Supabase CLI / local tooling.
SUPABASE_PROJECT_ID=

# Vite client-side aliases — REQUIRED for production builds. Vite inlines
# these into the browser bundle at `npm run build` time; without them the SPA
# cannot initialize Supabase in the browser. Set them in Railway → Variables
# (build + runtime) alongside the SUPABASE_* values above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=

# ---- Server -----------------------------------------------------------------
# Port the Express production server (npm start / npm run api) listens on.
# Railway injects PORT automatically; the default is 8787 when unset.
# PORT=8787

# Public URL of this deployment (used for auth callbacks and redirects).
# PUBLIC_URL=https://relay.example.com
# Auth callback + allowed sign-up domains (comma-separated).
# AUTH_REDIRECT_URL=https://relay.example.com/auth/callback
# AUTH_ALLOWED_DOMAINS=example.com

# Self-hosted stack only: set true to skip email confirmation on signup
# (wired into the docker-compose GoTrue container).
MAILER_AUTOCONFIRM=

# App-level signup policy (works for hosted Supabase too): when set to true,
# password signups go through the normal client-side flow and REQUIRE the user
# to click a confirmation email (SMTP must be configured in the Supabase
# dashboard). When unset (default), the app auto-confirms new accounts via the
# admin API — no confirmation email needed, and the GoTrue signup rate limiter
# is never hit. Restore strict verification by setting this to "true".
# AUTH_REQUIRE_EMAIL_CONFIRM=true

# ---- AI providers (at least one enables AI features) -----------------------
# Puter — free cloud AI (400+ models across 70+ providers), no billing keys.
# Node needs a free personal token at https://puter.com/app (Settings → User →
# Personal Token); the browser SDK is the only keyless path. When set, Puter
# sits at the front of the fallback chain and also powers voice TTS/STT.
PUTER_USER_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# One key, hundreds of models. The chat fallback chain is
# Puter -> Gemini -> OpenAI -> OpenRouter -> Anthropic -> Groq.
OPENROUTER_API_KEY=

# Optional provider model overrides (defaults apply if unset).
# RELAI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GROQ_MODEL=llama-3.3-70b-versatile
# PUTER_MODEL=gpt-5-nano
# Puter voice overrides (defaults apply if unset). TTS engines: standard /
# neural / long-form / generative (AWS Polly); PUTER_TTS_VOICE must match the
# engine's language, e.g. neural + Joanna (en-US).
# PUTER_TTS_ENGINE=neural
# PUTER_TTS_VOICE=Joanna
# PUTER_TTS_LANGUAGE=en-US
# PUTER_STT_MODEL=whisper-1
# Model used for agent tool-calling when it falls back to Groq (must support
# OpenAI function calling). Defaults to openai/gpt-oss-120b; llama-3.1-8b-instant
# is a smaller known-good fallback inside the code.
# RELAI_GROQ_TOOL_MODEL=openai/gpt-oss-120b
# Optional Groq API base URL override (defaults to https://api.groq.com/openai/v1).
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter chat model. Defaults to the free-tier openai/gpt-oss-20b:free so
# a key with no purchased credits works out of the box; switch to a paid model
# (e.g. openai/gpt-4o) after topping up credits.
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Model used for agent tool-calling when it falls back to OpenRouter
# (defaults to the same free-tier model above).
# RELAI_OPENROUTER_TOOL_MODEL=openai/gpt-oss-20b:free
# Optional OpenRouter base URL override (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional daily AI call budget per user (defaults to 200 when unset).
RELAI_DAILY_AI_CALL_CAP=

# Optional local AI.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Embedding model overrides (defaults apply if unset).
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OPENAI_EMBED_MODEL=text-embedding-3-small

# LiteLLM Gateway - uncomment to enable additional providers
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Brain service (Python companion) --------------------------------------
# Classic Node API (npm run api) proxies brain turns here. Point it at the
# Python brain service: BRAIN_SERVICE_URL=http://localhost:8088
# BRAIN_SERVICE_URL=http://localhost:8088
# Optional bearer token for the classic Node API (/api/* routes). When set,
# every request must send `Authorization: Bearer <token>` or it gets a 401.
# API_TOKEN=
# Optional bearer token for the Python brain service. Same contract as above;
# the Express proxy forwards it automatically when set.
# BRAIN_SERVICE_TOKEN=
# Comma-separated list of extra origins allowed to call the classic API.
# Defaults to same-origin only (the built SPA shell). No `*` is ever used.
# CORS_ORIGINS=https://app.example.com

# Brain feeds (Python brain service) - both default to on; set to false to
# disable. They degrade gracefully to empty results when Supabase is down.
# ENABLE_RELAY_CONTEXT=true
# ENABLE_CORPUS_SEARCH=true

# ---- Continuous knowledge ingestion (Python brain service) -----------------
# The companion's KnowledgeBot: periodically fetches configured sources (RSS,
# GitHub, arXiv, OpenAlex, Crossref, Wikipedia, Hugging Face, web pages),
# dedupes + scores + extracts claims/entities/relations/versions, embeds into
# pgvector (global tables), and auto-refreshes a source when a chat question
# matches its topics. Master switch; defaults to on when BRAIN_SERVICE_URL is set.
# ENABLE_KNOWLEDGE_INGESTION=true
# Store backend: "auto" uses Supabase when SUPABASE_SERVICE_ROLE_KEY is set,
# otherwise a local JSON store under .relayhub/ingest.
# INGEST_STORE=auto
# Background scheduler tick + per-source document cap.
# INGEST_SCHEDULER_ENABLED=true
# INGEST_SCHEDULER_TICK_SECONDS=60
# INGEST_MAX_DOCUMENTS_PER_SOURCE=20
# Optional API keys for richer connectors (leave empty to use public endpoints).
# GITHUB_TOKEN=
# OPENALEX_API_KEY=

# Allow the agent's py_exec tool: executes generated Python in the companion's
# disposable sandbox (scientific stack allowed, system/framework imports
# refused, CPU/RAM/time/output capped). Off by default — the tool is hidden
# from the model unless this is exactly "true".
# RELAY_ALLOW_CODE_EXEC=true

# Allow the wheel-install capability to `pip install` a wheel stored in the
# vendored bundle registry (companion/vendor/archives/, e.g. the PyTorch CUDA
# bundle, TensorFlow, ONNX Runtime GPU). This MUTATES the Python environment,
# so it is off by default. The registry is locked — arbitrary paths, URLs and
# package names are never accepted.
# COMPANION_ALLOW_WHEEL_INSTALL=true

# ---- Feature secrets (required only for features you enable) ----------------
WORKFLOW_TICK_SECRET=
TELEGRAM_API_KEY=
APP_USER_CONNECTION_KEY_SECRET=
FIRECRAWL_API_KEY=
APIFY_API_KEY=
RESEND_API_KEY=

# Direct OAuth client credentials (configure only the providers you use).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# n8n automation
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE=

# ---- Relay Data Access Layer ----------------------------------------------
# Optional credentials for the agent's data connectors. Every connector
# degrades gracefully when its key is absent (public/no-key resources work
# with nothing set). Never expose these to client JS.
# RapidAPI marketplace: search is keyless best-effort; execute needs the key.
# RAPIDAPI_KEY=
# Mockaroo synthetic data (the local seeded generator needs no key).
# MOCKAROO_API_KEY=
# GitHub × BigQuery repository intelligence: project id + service account.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Alternatively, inline service-account JSON (kept server-side only).
# GOOGLE_SERVICE_ACCOUNT=
# Override the public GitHub dataset (defaults to bigquery-public-data.github_repos).
# BIGQUERY_GITHUB_DATASET=bigquery-public-data.github_repos
# Live GitHub REST API: public endpoints run keyless at 60 req/hr; set a
# token (classic PAT with `repo` scope, or fine-grained with Contents:Read)
# for 5000 req/hr and code search.
# GITHUB_TOKEN=
# Kaggle dataset discovery.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Vector store (Qdrant)
QDRANT_API_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=relai_memories

# ---- Search Providers -------------------------------------------------------
# Tavily - AI-native search (requires API key from tavily.com)
TAVILY_API_KEY=
# Exa - embeddings-based search (requires API key from exa.ai)
EXA_API_KEY=
# Jina Reader - AI reader & search (free tier available)
JINA_API_KEY=
# SearXNG - self-hosted meta search engine
SEARXNG_BASE_URL=

# Browser automation
PLAYWRIGHT_WS_ENDPOINT=
# BROWSER_WS_ENDPOINT=

# ---- Face / Reverse-Image Search (sweep_neural_mesh.face_search) -----------
# Finds where a photo appears online: social profiles (LinkedIn, Instagram,
# Facebook, X, TikTok, ...) plus news, blogs and other web sources.
# All of these are optional; keyless name search works with no keys at all.
# One key unlocks four engines: Google Lens, Yandex Images, Bing Reverse
# Image and Google Images (serpapi.com — free tier: 100 searches/month).
SERPAPI_KEY=
# TinEye Search API (HMAC-signed; both keys required).
TINEYE_API_KEY=
TINEYE_PRIVATE_KEY=
# Public https base of this host. When set, face crops are written to the
# uploads dir and URL-based providers (SerpAPI, TinEye URL mode) can fetch
# them at <base>/uploads/face_search/<file>.jpg. Without it, URL-based
# providers are skipped and only keyless + upload-capable sources run.
SWEEP_PUBLIC_BASE_URL=
# Where crops are written for static serving (default: <tmp>/sweep_face_search_uploads).
SWEEP_UPLOADS_DIR=
# Override the insightface model pack location (default: models/face/insightface).
# SWEEP_FACE_MODELS=

# Prefix-style fetch proxy for crawls/searches, e.g. https://proxy.example.com/?url=
# RELAI_PROXY_URL=

# Voice (automatic free-first fallback chain: puter → elevenlabs → groq → hosted)
# No engine pin needed: the server uses the first *configured* provider and
# falls through if it fails, so RVOS keeps working when one key is dead or
# rate-limited. Free tiers first: Puter (PUTER_USER_TOKEN), then ElevenLabs
# Scribe STT + TTS (ELEVENLABS_API_KEY), then Groq Whisper STT + Orpheus TTS
# (GROQ_API_KEY), then paid OpenAI (OPENAI_API_KEY).
# Pin a single engine (disable fallback) with:
RELAI_STT_ENGINE=hosted
RELAI_TTS_ENGINE=hosted
# RELAI_VOICE_WORKER_URL=http://localhost:8760
# RELAI_VOICE_WORKER_TOKEN=your_token_here
# STT engines: puter | elevenlabs | groq | hosted | whisper_cpp | faster_whisper
# TTS engines: puter | elevenlabs | groq | hosted | coqui_xtts | bark | rvc | piper
# ElevenLabs overrides (Scribe v1 STT + eleven_turbo_v2_5 TTS). The default
# TTS voice is a free-plan premade UUID (Adam); pass any UUID or name via
# ELEVENLABS_TTS_VOICE (name-based library voices like "Rachel" need a paid plan).
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_TTS_VOICE=pNInz6obpgDQGcFmaJgB
# ElevenLabs Realtime (optional): creates a Conversational AI agent session so
# RVOS can run a live low-latency conversation. Needs ELEVENLABS_API_KEY above
# PLUS the id of a conversational agent you created in ElevenLabs. The key
# stays server-side; the browser only ever receives the signed wss URL.
# ELEVENLABS_AGENT_ID=
# Hume EVI Realtime (optional): creates an Empathic Voice Interface session so
# RVOS can run a live emotionally-aware conversation. Needs the API key + secret
# (server exchanges them for a short-lived access token) PLUS the id of an EVI
# configuration built in the Hume portal (app.hume.ai). Keys stay server-side;
# the browser only ever receives the signed wss URL.
# HUME_API_KEY=
# HUME_SECRET_KEY=
# HUME_CONFIG_ID=
# Retell AI Realtime (optional): creates a Retell web call so RVOS can run a
# live conversation with a Retell voice agent (reliable interruption/barge-in).
# Needs the API key PLUS the id of an agent you created in the Retell portal
# (dashboard.retellai.com). The key stays server-side; the browser only ever
# receives the per-call access token + signed audio-websocket URL.
# RETELL_API_KEY=
# RETELL_AGENT_ID=
# Groq voice overrides (free tier; default whisper-large-v3-turbo STT +
# canopylabs/orpheus-v1-english TTS). Orpheus voices:
# tara | leah | jess | leo | dan | mia | zac | zoe | oll
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=tara

# Observability (Langfuse) - optional, degrades gracefully when unset.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# Optional AI-framework capability endpoints (companion brain)
# These unlock py_compute capabilities when the companion service is deployed
# alongside the matching local servers. All are optional.
# OLLAMA_EMBED_MODEL=nomic-embed-text
# TGI_BASE_URL=http://localhost:8080
# LANGFLOW_BASE_URL=http://localhost:7860
# LANGFLOW_API_KEY=
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# Sweep local service security (launcher generates temporary tokens if unset)
# SWEEP_API_TOKEN=
# BRAIN_SERVICE_TOKEN=
# SWEEP_DEBUG=false
# CORS_ORIGINS=http://localhost:3000
# ALLOW_CODE_EXECUTION=false
# INGEST_SCHEDULER_ENABLED=false
# ALLOW_REMOTE_BROWSER=false
